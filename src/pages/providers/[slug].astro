---
import Base from '../../layouts/Base.astro';
import PriceTable from '../../components/PriceTable.astro';
import Sparkline from '../../components/Sparkline.astro';
import { getHistory, getPlansByProvider, getProviders } from '../../lib/data';
import { formatDate, formatPerGbRam, formatRand } from '../../lib/format';
import { featureInfo } from '../../lib/features';
import { SITE_URL } from '../../lib/site';
import type { Provider } from '../../lib/schema';

interface Props {
  provider: Provider;
}

export function getStaticPaths() {
  return getProviders().map((provider) => ({
    params: { slug: provider.slug },
    props: { provider },
  }));
}

const { provider } = Astro.props;
const allPlans = getPlansByProvider().get(provider.slug) ?? [];
const livePlans = allPlans.filter((plan) => plan.status !== 'archived');
const cheapest = [...livePlans].sort((a, b) => a.priceInclVatCents - b.priceInclVatCents)[0];
const bestValue = livePlans.length
  ? livePlans.reduce((best, plan) => (plan.pricePerGbRamCents < best.pricePerGbRamCents ? plan : best))
  : undefined;
const history = getHistory(provider.slug);
const lastUpdated = allPlans.reduce((latest, plan) => (plan.lastChecked > latest ? plan.lastChecked : latest), '');
const year = new Date().getFullYear();

const vatLabel =
  provider.vat === 'incl'
    ? 'Prices include VAT'
    : provider.vat === 'excl'
      ? 'Prices exclude VAT (grossed up by 15%)'
      : 'VAT treatment not stated (assumed exclusive)';

const title = `${provider.name} VPS pricing in South Africa (${year})`;
const description = cheapest
  ? `${provider.name} VPS plans in South Africa, from ${formatRand(cheapest.priceInclVatCents)} per month including VAT. Compare specs, features and price history.`
  : `${provider.name} has no live VPS plans in the current comparison. See the archived plan and price history.`;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
      { '@type': 'ListItem', position: 2, name: 'Providers', item: `${SITE_URL}/providers/` },
      { '@type': 'ListItem', position: 3, name: provider.name, item: `${SITE_URL}/providers/${provider.slug}/` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: provider.name,
    url: provider.website,
    areaServed: 'ZA',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `${provider.name} VPS plans`,
    numberOfItems: allPlans.length,
    itemListElement: allPlans.map((plan, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'Product',
        name: `${provider.name} ${plan.plan}`,
        description: `${plan.vcpu} vCPU, ${plan.ramGb} GB RAM, ${plan.storageGb} GB ${plan.storageType.toUpperCase()}`,
        offers: {
          '@type': 'Offer',
          price: (plan.priceInclVatCents / 100).toFixed(2),
          priceCurrency: 'ZAR',
          availability: plan.status === 'archived' ? 'https://schema.org/Discontinued' : 'https://schema.org/InStock',
          url: plan.url,
        },
      },
    })),
  },
];
---

<Base title={title} description={description} canonicalPath={`/providers/${provider.slug}/`} jsonLd={structuredData}>
  <section class="provider-hero">
    <div class="container">
      <span class="section-label">Provider</span>
      <h1>{provider.name}</h1>
      <p class="hero-lede">{provider.reputation}</p>
      <div class="provider-meta">
        {provider.locations.map((location) => <span class="badge badge-outline">{location}</span>)}
        <span class="badge badge-outline">{vatLabel}</span>
        <a class="badge badge-outline" href={provider.website} target="_blank" rel="noopener">Website ↗</a>
        <a class="badge badge-outline" href={provider.pricingUrl} target="_blank" rel="noopener">Pricing page ↗</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="provider-grid">
        <div class="stack">
          <div class="stat-grid">
            <div class="stat-box">
              <span>Live plans</span>
              <strong>{livePlans.length}</strong>
            </div>
            <div class="stat-box">
              <span>Cheapest</span>
              <strong>{cheapest ? formatRand(cheapest.priceInclVatCents) : '—'}</strong>
            </div>
            <div class="stat-box">
              <span>Best per GB</span>
              <strong>{bestValue ? formatPerGbRam(bestValue.pricePerGbRamCents) : '—'}</strong>
            </div>
            <div class="stat-box">
              <span>Last checked</span>
              <strong>{lastUpdated ? formatDate(lastUpdated) : '—'}</strong>
            </div>
          </div>

          {livePlans.length === 0 && (
            <div class="callout">
              <strong>No live plans.</strong> This provider's VPS product is not currently advertised.
              The last known plan is kept below for history and is excluded from the main comparison.
            </div>
          )}

          <PriceTable plans={allPlans} showRank={false} />

          {allPlans.some((plan) => plan.notes) && (
            <div class="provider-card">
              <h2 style="font-size: 1.1rem; margin-bottom: 10px;">Plan notes</h2>
              <ul class="history-list" role="list">
                {allPlans.filter((plan) => plan.notes).map((plan) => (
                  <li>
                    <span><strong>{plan.plan}</strong>: {plan.notes}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>

        <div class="stack">
          <Sparkline entries={history} label={provider.name} />

          <div class="provider-card">
            <h2 style="font-size: 1.1rem; margin-bottom: 10px;">Features</h2>
            <div class="badge-stack">
              {provider.features.map((feature) => (
                <span class="badge" title={featureInfo(feature).description}>{featureInfo(feature).label}</span>
              ))}
            </div>
          </div>

          {provider.notes && (
            <div class="provider-card">
              <h2 style="font-size: 1.1rem; margin-bottom: 10px;">Editorial note</h2>
              <p class="plan-sub">{provider.notes}</p>
            </div>
          )}

          <div class="provider-card">
            <h2 style="font-size: 1.1rem; margin-bottom: 10px;">Compare</h2>
            <p class="plan-sub" style="margin-bottom: 12px;">
              See how {provider.name} stacks up against every other South African provider.
            </p>
            <a class="button button-secondary" href="/#compare">Open the comparison table</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
