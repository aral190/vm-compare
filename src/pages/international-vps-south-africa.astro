---
import Base from '../layouts/Base.astro';
import InternationalPriceTable from '../components/InternationalPriceTable.astro';
import { EUR_ZAR, HOURS_PER_MONTH, USD_ZAR, providers, rows } from '../lib/international';
import { formatRand } from '../lib/format';
import { SITE_URL } from '../lib/site';

const cheapest = rows[0];
const saPlanCount = rows.filter((row) => row.region === 'South Africa').length;
const europePlanCount = rows.filter((row) => row.region === 'Europe').length;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'International Providers',
        item: `${SITE_URL}/international-vps-south-africa/`,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'International VPS providers with South Africa or Europe regions',
    numberOfItems: rows.length,
    itemListElement: rows.map((row, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'Product',
        name: `${row.provider} ${row.plan}`,
        description: `${row.region}: ${row.vcpu} vCPU, ${row.ramGb} GB RAM, ${row.storage}, ${row.traffic} traffic`,
        brand: { '@type': 'Brand', name: row.provider },
        offers: {
          '@type': 'Offer',
          price: (row.zarInclVatCents / 100).toFixed(2),
          priceCurrency: 'ZAR',
          availability: 'https://schema.org/InStock',
          url: row.providerUrl,
        },
      },
    })),
  },
];
---

<Base
  title="International VPS with South Africa and Europe regions (2026)"
  description={`Compare ${rows.length} international VPS plans from ${providers.length} providers with South Africa or Europe regions, including Vultr, Akamai/Linode, AWS, Webdock and Contabo. Month-to-month prices converted to rand including VAT.`}
  canonicalPath="/international-vps-south-africa/"
  jsonLd={structuredData}
>
  <section class="provider-hero">
    <div class="container">
      <span class="section-label">International providers</span>
      <h1>International VPS with South Africa and Europe regions</h1>
      <p class="hero-lede">
        Global clouds with local regions, plus European value hosts that deliver more RAM for the
        money. Every price is shown month-to-month and converted to rand so you can compare like
        with like.
      </p>

      <div class="hero-stats">
        <span class="stat-pill"><strong>{providers.length}</strong> providers</span>
        <span class="stat-pill"><strong>{rows.length}</strong> plans</span>
        <span class="stat-pill"><strong>{saPlanCount}</strong> SA-hosted plans</span>
        <span class="stat-pill"><strong>{europePlanCount}</strong> Europe-hosted plans</span>
        <span class="stat-pill">Cheapest from <strong>{formatRand(cheapest.zarInclVatCents)}/mo</strong></span>
      </div>

      <div class="hero-actions">
        <a class="button button-primary" href="#compare">Compare all plans</a>
        <a class="button button-secondary" href="/#compare">South African providers</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="callout">
        <strong>How to read these numbers.</strong> USD list prices are converted at an indicative
        R{USD_ZAR.toFixed(2)}/US$ and EUR prices at R{EUR_ZAR.toFixed(2)}/€, then treated as
        VAT-exclusive and grossed up by 15% to match the local comparison. Where a provider offers
        several currencies (Webdock quotes EUR, DKK and USD), we use its USD price. VAT treatment
        depends on your billing country and whether reverse-charge rules apply. We use the
        month-to-month rate, not prepaid commitments: Webdock charges the same monthly price whether
        you pay monthly or yearly, and Contabo's 1-month rate is used instead of its 24-month
        prepay discount. Hourly cloud plans are estimated at {HOURS_PER_MONTH} hours per month. AWS
        storage is EBS only and billed separately.
      </div>
    </div>
  </section>

  <section class="section compare" id="compare">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="section-label">Full comparison</span>
          <h2>Every international plan, searchable and filterable</h2>
          <p>
            Search by provider or plan, filter by region, RAM, vCPU or provider, and sort by
            month-to-month price, value or resources. Plans with a South Africa region carry a
            green <span class="badge badge-region">SA regions</span> pill. Filters sync to the URL,
            so you can bookmark or share a view.
          </p>
        </div>
      </div>

      <InternationalPriceTable plans={rows} />
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>What gets included</h2>
      <p>
        Only providers with a South Africa or Europe region are listed. That keeps the comparison
        useful for a South African audience: local regions give the lowest latency, and Europe is
        the nearest low-cost alternative. Providers that only offer US, Asian or Australian
        regions are excluded, however cheap they look.
      </p>
      <p>
        A plan must be orderable at the price shown, on a month-to-month basis. Provider-wide
        discounts that require a 12- or 24-month prepayment are ignored, because the renewal or
        monthly price is what you actually pay.
      </p>

      <h2>Why keep them separate?</h2>
      <p>
        South African providers quote in rand and include VAT. International providers usually
        quote in USD or EUR, bill by the hour or by the month, charge separately for storage,
        snapshots and IPv4 addresses, and may apply reverse-charge VAT. Folding those numbers into
        the local rand-per-month table without a lot of assumptions would make the comparison less
        honest, not more.
      </p>
      <p>
        For a small South African project, a local provider is usually simpler. For larger
        workloads, or when raw RAM per rand matters more than latency, the European value hosts are
        hard to beat.
      </p>
      <p>
        <a href="/#compare">See the South African comparison →</a>
      </p>
    </div>
  </section>
</Base>
