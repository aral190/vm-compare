---
import GitHubIcon from './GitHubIcon.astro';
import { GITHUB_DISCUSSIONS_URL, GITHUB_URL } from '../lib/site';
import { withUtm } from '../lib/utm';
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="VM Compare South Africa home">
      <svg viewBox="0 0 64 64" aria-hidden="true">
        <rect width="64" height="64" rx="14" fill="#0f766e"></rect>
        <path d="M13 15 32 49 51 15" fill="none" stroke="#fff" stroke-width="9" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      <span>
        VM Compare
        <small>South Africa</small>
      </span>
    </a>

    <nav class="site-nav" aria-label="Main navigation">
      <a href="/#compare">Compare</a>
      <a href="/providers/">Providers</a>
      <a href="/methodology/">Methodology</a>
      <a href="/faq/">FAQ</a>
      <a class="nav-github" href={withUtm(GITHUB_URL)} target="_blank" rel="noopener">
        <GitHubIcon /> GitHub
      </a>
      <a class="nav-cta" href={withUtm(GITHUB_DISCUSSIONS_URL)} target="_blank" rel="noopener">Add a provider</a>
    </nav>

    <details class="mobile-menu">
      <summary class="button button-secondary">Menu</summary>
      <nav aria-label="Mobile navigation">
        <a href="/#compare">Compare VPS prices</a>
        <a href="/providers/">Providers</a>
        <a href="/cheapest-1gb-vps-south-africa/">Cheapest 1 GB</a>
        <a href="/cheapest-4gb-vps-south-africa/">Cheapest 4 GB</a>
        <a href="/methodology/">Methodology</a>
        <a href="/faq/">FAQ</a>
        <a href={withUtm(GITHUB_URL)} target="_blank" rel="noopener"><GitHubIcon /> GitHub</a>
        <a href={withUtm(GITHUB_DISCUSSIONS_URL)} target="_blank" rel="noopener">Add a provider</a>
      </nav>
    </details>
  </div>
</header>
