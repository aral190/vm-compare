---
import GitHubIcon from './GitHubIcon.astro';
import { CURRENT_YEAR, GITHUB_DISCUSSIONS_URL, GITHUB_URL, PUBLISHER_URL } from '../lib/site';
import { getProviders } from '../lib/data';
import { withUtm } from '../lib/utm';

const providers = getProviders();
const topProviders = providers.slice(0, 6);
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a class="brand" href="/">
          <svg viewBox="0 0 64 64" aria-hidden="true">
            <rect width="64" height="64" rx="14" fill="#6742d6"></rect>
            <path d="M13 15 32 49 51 15" fill="none" stroke="#fff" stroke-width="9" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          <span>VM Compare<small>South Africa</small></span>
        </a>
        <p class="footer-about">
          Independent, weekly comparison of VPS and VM pricing in South African data centres.
          Prices are normalised to VAT-inclusive rand so you can compare like with like.
        </p>
      </div>

      <div>
        <h3>Compare</h3>
        <a href="/">All plans</a>
        <a href="/cheapest-1gb-vps-south-africa/">Cheapest 1 GB</a>
        <a href="/cheapest-2gb-vps-south-africa/">Cheapest 2 GB</a>
        <a href="/cheapest-4gb-vps-south-africa/">Cheapest 4 GB</a>
        <a href="/cheapest-8gb-vps-south-africa/">Cheapest 8 GB</a>
        <a href="/cheapest-16gb-vps-south-africa/">Cheapest 16 GB</a>
      </div>

      <div>
        <h3>Providers</h3>
        {topProviders.map((provider) => (
          <a href={`/providers/${provider.slug}/`}>{provider.name}</a>
        ))}
        <a href="/providers/">All providers</a>
      </div>

      <div>
        <h3>Site</h3>
        <a href="/methodology/">Methodology</a>
        <a href="/faq/">FAQ</a>
        <a href="/updates/">Price updates</a>
        <a href="/international-vps-south-africa/">International Providers</a>
        <a href="/about/">About</a>
        <a href={withUtm(GITHUB_DISCUSSIONS_URL)} target="_blank" rel="noopener">Suggest a provider</a>
        <a class="footer-github" href={withUtm(GITHUB_URL)} target="_blank" rel="noopener">
          <GitHubIcon /> Source on GitHub
        </a>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {CURRENT_YEAR} VM Compare South Africa. Independent comparison.</span>
      <span class="footer-bottom-links">
        <a href={withUtm(GITHUB_URL)} target="_blank" rel="noopener">
          <GitHubIcon /> GitHub
        </a>
        <span>
          Companion to <a href={withUtm(PUBLISHER_URL)} rel="noopener">number1.co.za</a>. Prices checked weekly.
        </span>
      </span>
    </div>
  </div>
</footer>
