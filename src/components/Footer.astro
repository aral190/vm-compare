---
import { CONTACT_EMAIL, CURRENT_YEAR, GITHUB_URL, PUBLISHER_URL } from '../lib/site';
import { getProviders } from '../lib/data';

const providers = getProviders();
const topProviders = providers.slice(0, 6);
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a class="brand" href="/">
          <svg viewBox="0 0 64 64" aria-hidden="true">
            <rect width="64" height="64" rx="14" fill="#0f766e"></rect>
            <path d="M16 22h20a10 10 0 0 1 0 20H16" fill="none" stroke="#fff" stroke-width="5" stroke-linecap="round"></path>
            <circle cx="16" cy="22" r="5" fill="#fff"></circle>
            <circle cx="16" cy="42" r="5" fill="#fff"></circle>
            <path d="M44 22v20M52 22v20" stroke="#99f6e4" stroke-width="4" stroke-linecap="round"></path>
          </svg>
          <span>VM Compare<small>South Africa</small></span>
        </a>
        <p class="footer-about">
          Independent, weekly comparison of VPS and VM pricing in South African data centres.
          Prices are normalised to VAT-inclusive rand so you can compare like with like.
        </p>
        <p class="footer-about">
          <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
        </p>
      </div>

      <div>
        <h3>Compare</h3>
        <a href="/">All plans</a>
        <a href="/cheapest-1gb-vps-south-africa/">Cheapest 1 GB</a>
        <a href="/cheapest-2gb-vps-south-africa/">Cheapest 2 GB</a>
        <a href="/cheapest-4gb-vps-south-africa/">Cheapest 4 GB</a>
        <a href="/cheapest-8gb-vps-south-africa/">Cheapest 8 GB</a>
        <a href="/cheapest-16gb-vps-south-africa/">Cheapest 16 GB</a>
      </div>

      <div>
        <h3>Providers</h3>
        {topProviders.map((provider) => (
          <a href={`/providers/${provider.slug}/`}>{provider.name}</a>
        ))}
        <a href="/providers/">All providers</a>
      </div>

      <div>
        <h3>Site</h3>
        <a href="/methodology/">Methodology</a>
        <a href="/faq/">FAQ</a>
        <a href="/updates/">Price updates</a>
        <a href="/international-vps-south-africa/">International JNB VPS</a>
        <a href="/about/">About</a>
        <a href="/suggest-a-provider/">Suggest a provider</a>
        <a href={GITHUB_URL} rel="noopener">Source on GitHub</a>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {CURRENT_YEAR} VM Compare South Africa. Independent comparison.</span>
      <span>
        Companion to <a href={PUBLISHER_URL} rel="noopener">number1.co.za</a>. Prices checked weekly.
      </span>
    </div>
  </div>
</footer>
