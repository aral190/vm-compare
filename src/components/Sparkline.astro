---
import type { HistoryEntry } from '../lib/schema';
import { formatDate, formatRandCompact } from '../lib/format';

interface Props {
  entries: HistoryEntry[];
  label: string;
}

const { entries, label } = Astro.props;
const sorted = [...entries].sort((a, b) => a.date.localeCompare(b.date));
const points = sorted.map((entry) => ({
  date: entry.date,
  price: Math.min(...entry.plans.map((plan) => plan.priceInclVatCents)),
}));

const width = 600;
const height = 150;
const padX = 18;
const padY = 24;

const prices = points.map((point) => point.price);
const min = prices.length ? Math.min(...prices) : 0;
const max = prices.length ? Math.max(...prices) : 0;
const span = Math.max(1, max - min);
const stepX = points.length > 1 ? (width - padX * 2) / (points.length - 1) : 0;

const coords = points.map((point, index) => ({
  x: padX + index * stepX,
  y: padY + ((max - point.price) / span) * (height - padY * 2),
  ...point,
}));

const line = coords.map((point) => `${point.x.toFixed(1)},${point.y.toFixed(1)}`).join(' ');
const area = coords.length
  ? `M ${coords[0].x.toFixed(1)} ${height - padY} L ${coords
      .map((point) => `${point.x.toFixed(1)} ${point.y.toFixed(1)}`)
      .join(' L ')} L ${coords[coords.length - 1].x.toFixed(1)} ${height - padY} Z`
  : '';
---

<div class="provider-card">
  <div class="winner-tier" style="margin-bottom: 8px;">
    <strong>Price history</strong>
    <span>{sorted.length} snapshot{sorted.length === 1 ? '' : 's'}</span>
  </div>

  {points.length === 0 ? (
    <p class="plan-sub">No history recorded yet.</p>
  ) : (
    <>
      <svg
        viewBox={`0 0 ${width} ${height}`}
        role="img"
        aria-label={`${label} cheapest price over time`}
        style="width: 100%; height: auto;"
      >
        <defs>
          <linearGradient id="history-fill" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#6742d6" stop-opacity="0.18"></stop>
            <stop offset="100%" stop-color="#6742d6" stop-opacity="0"></stop>
          </linearGradient>
        </defs>
        <line x1={padX} y1={height - padY} x2={width - padX} y2={height - padY} stroke="#e5e5e5" stroke-width="1"></line>
        {points.length > 1 && <path d={area} fill="url(#history-fill)"></path>}
        <polyline
          points={line}
          fill="none"
          stroke="#6742d6"
          stroke-width="2.5"
          stroke-linejoin="round"
          stroke-linecap="round"
        ></polyline>
        {coords.map((point) => (
          <circle cx={point.x} cy={point.y} r="3.5" fill="#6742d6">
            <title>{`${formatDate(point.date)}: ${formatRandCompact(point.price)}`}</title>
          </circle>
        ))}
        <text x={padX} y={14} font-size="11" fill="#525252">{formatRandCompact(max)}</text>
        <text x={padX} y={height - 6} font-size="11" fill="#737373">{formatRandCompact(min)}</text>
        <text x={width - padX} y={height - 6} font-size="11" fill="#737373" text-anchor="end">
          {formatDate(sorted[sorted.length - 1].date)}
        </text>
      </svg>
      <p class="plan-sub" style="margin-top: 4px;">
        Cheapest advertised plan at each weekly check. Prices include VAT.
      </p>
    </>
  )}
</div>
