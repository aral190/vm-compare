{
  "name": "vm-compare",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Cheapest VPS and VM prices in South African data centres, compared weekly.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
